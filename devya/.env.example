APP_NAME="DEVYA CEYLON"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/devya_ceylon/devya/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_ENABLED=false
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=15
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@devyaceylon.lk"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BRAND_COMPANY_NAME="DEVYA CEYLON"
BRAND_COMPANY_SHORT_NAME="DEVYA CEYLON"
BRAND_SYSTEM_NAME="Ayurveda Channelling Centre"
BRAND_SYSTEM_SHORT_NAME="DEVYA CEYLON"
BRAND_HOSPITAL_LABEL="Ayurveda Channelling Centre"
BRAND_TAGLINE="Empowering Well-being"
BRAND_QUEUE_SHORT_NAME="DEVYA"
BRAND_QUEUE_TAGLINE="Ayurveda Channelling Centre"
BRAND_QUEUE_SECONDARY_NAME="Ayurveda Channelling Centre"
BRAND_WEBSITE_LABEL="DEVYA CEYLON website"
BRAND_WEBSITE_URL="https://devyaceylon.lk/"
BRAND_LOGO_PATH="images/logo.png"
BRAND_FAVICON_PATH="images/favicon.png"

APPOINTMENT_NOTIFICATION_EMAIL="info@devyaceylon.lk"
APPOINTMENT_NOTIFICATION_WHATSAPP="94713423173"
WEBSITE_CONSULTATION_FEE_LKR=3000
WEBSITE_BOOKING_ADVANCE_LKR=1500

# Set these after receiving PayHere sandbox merchant credentials.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Must be a publicly reachable HTTPS URL for payment notifications.
PAYHERE_NOTIFY_URL=
